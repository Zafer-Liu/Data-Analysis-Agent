{
  "name": "data-analysis-agent-frontend",
  "private": true,
  "version": "1.5.2",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "vite build --config frontend/config/vite.config.js && node scripts/build-chat.mjs",
    "build:chat": "node scripts/build-chat.mjs",
    "build:check": "node scripts/build-chat.mjs",
    "check:publication": "python scripts/check_public_boundary.py",
    "check:tools": "python scripts/check_tool_contracts.py",
    "test:charts": "python -m pytest Function/Charts_generation/tests -q",
    "format": "prettier --write \"frontend/core/**/*.js\" \"frontend/entries/**/*.js\" \"frontend/config/*.js\" \"eslint.config.js\" \"package.json\"",
    "format:check": "prettier --check \"frontend/core/**/*.js\" \"frontend/entries/**/*.js\" \"frontend/config/*.js\" \"eslint.config.js\" \"package.json\"",
    "lint": "eslint \"frontend/**/*.js\" \"static/js/**/*.js\"",
    "quality": "npm run check:publication && npm run format:check && npm run lint && npm run build:check && npm run check:tools && npm run test:charts"
  },
  "prettier": {
    "printWidth": 100,
    "semi": true,
    "singleQuote": false,
    "trailingComma": "all"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^8.3.5"
  }
}
