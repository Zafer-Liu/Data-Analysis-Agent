# ============================================================
#  Business Analytics Agent — .gitignore
# ============================================================

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version

# ---- Build / dist ----
node_modules/
build/
dist/
frontend/dist/
# The Flask app serves Vite output directly from static/dist in source builds.
# Keep generated runtime assets trackable so GitHub users do not load a 404 shell.
static/dist/*
!static/dist/
!static/dist/*.js
!static/dist/*.css
!static/dist/chunks/
!static/dist/chunks/**
!static/dist/assets/
!static/dist/assets/**
!static/dist/.vite/
!static/dist/.vite/**
*.spec
!packaging/business_agent.spec
*.egg-info/
.eggs/

# ---- Runtime / cache ----
.deps_installed
.session_tmps/
outputs/
tmp/
uploads/
*.log
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
auth.db
auth.db-wal
auth.db-shm

# ---- Regression tests ----
# Version the shared runtime regressions; keep unrelated local experiments ignored.
/tests/*
!/tests/test_chart_selector.py
!/tests/chat-bundle.test.mjs
!/tests/markdown-stream.test.mjs
!/tests/sse-retry.test.mjs
!/tests/ui-registry.test.mjs
!/tests/test_account_menu.py
!/tests/test_admin_console.py
!/tests/test_desktop_launcher.py
!/tests/test_diagram_theme.py
!/tests/test_feishu_bot.py
!/tests/test_gpu_analysis_fallback.py
!/tests/test_heatmap_generation.py
!/tests/test_hosted_models.py
!/tests/test_model_api_security.py
!/tests/test_privacy_boundaries.py
!/tests/test_developer_api_removed.py
!/tests/test_quota_model_ledger.py
!/tests/test_report_export_regressions.py
!/tests/test_sql_shadow.py
!/tests/test_table_ingest.py
!/tests/test_tool_governance.py
!/tests/test_workspace_artifact_cleanup.py

# Keep the tests already tracked by Git for GitHub Actions, but do not add
# newly created local tests to the repository.
Test/*
!Test/test_workflow_contracts.py
!Test/test_workflows.py
!Test/test_workflow_scheduler.py
!Test/test_job_terminal_listeners.py
!Test/test_workflow_runtime.py
!Test/test_workspace_storage_workflow_refs.py
!Test/test_workflow_frontend_panel.py
!Test/test_workflow_sqlite_locking.py
!Test/fixtures/
!Test/fixtures/workflows/
!Test/fixtures/workflows/operating_analysis_v1.json
Test/local_*.py
Test/test_workspace_storage_cleanup.py

# Keep all development tests local.
Test/

